{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@vedoy/booking": [
        "./packages/booking/dist/index"
      ],
      "@vedoy/booking/styles.css": [
        "./packages/booking/dist/styles.css"
      ],
      "@vedoy/notes": [
        "./packages/notes/dist/index"
      ],
      "@vedoy/notes/styles.css": [
        "./packages/notes/dist/styles.css"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backups",
    "published-versions",
    "packages/booking/src",
    "packages/booking/dist"
  ]
}
