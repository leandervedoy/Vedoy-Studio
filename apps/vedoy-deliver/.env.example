# Create a dedicated Supabase project and run supabase/schema.sql before launching.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put service_role/secret keys in NEXT_PUBLIC_ variables.

# Server-only secrets. Configure in hosting provider, never in client code.
SUPABASE_SERVICE_ROLE_KEY=
DELIVER_PUBLIC_ORIGIN=https://deliver.example.com
DELIVER_IDENTITY_PEPPER=
SIGNICAT_ACCOUNT_ID=
SIGNICAT_CLIENT_ID=
SIGNICAT_CLIENT_SECRET=
SIGNICAT_TOKEN_URL=
SIGNICAT_SCOPE=signicat-api
