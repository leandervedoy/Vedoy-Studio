{
  "name": "vedoy-studio-fullstack",
  "version": "0.1.0",
  "private": true,
  "description": "Vedøy Studio – domener, hosting, booking, API-er, analyse, Vedi AI, Academy og personlig support i ett Next.js-prosjekt.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:shopify": "npm run dev --workspace=@vedoy/vedoy-shopify",
    "build": "npm run build:booking && npm run build:notes && next build",
    "build:shopify": "npm run build --workspace=@vedoy/vedoy-shopify",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "npm run build:booking && npm run build:notes && tsc --noEmit",
    "typecheck:shopify": "npm run typecheck --workspace=@vedoy/vedoy-shopify",
    "build:booking": "npm run build --workspace=@vedoy/booking",
    "build:notes": "npm run build --workspace=@vedoy/notes",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate:requests": "node scripts/migrate-requests.mjs",
    "db:migrate:notes": "node scripts/migrate-notes.mjs",
    "db:migrate:notes-workspace": "node scripts/migrate-notes-workspace.mjs",
    "db:migrate:notes-advanced": "node scripts/migrate-notes-advanced.mjs",
    "db:migrate:growth": "node scripts/migrate-growth.mjs",
    "db:migrate:notifications": "node scripts/migrate-notifications.mjs",
    "check:project": "node scripts/check-project.mjs",
    "verify:notes": "node scripts/verify-notes-api.mjs",
    "postinstall": "npm run build:booking && npm run build:notes"
  },
  "dependencies": {
    "@vedoy/booking": "*",
    "@vedoy/notes": "*",
    "@vercel/analytics": "^2.0.1",
    "motion": "13.1.0",
    "next": "^16.3.2",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
