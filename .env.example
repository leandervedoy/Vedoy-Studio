# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Authentication. Required in production when demo mode is disabled.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=demo@vedoy.no
ADMIN_PASSWORD=vedoydemo

# Optional PostgreSQL database (Neon, Supabase, Railway, Prisma Postgres, etc.)
DATABASE_URL=

# Optional Vedi AI integration. Never expose this value in client-side code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional provider adapters. The demo works without these.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
DOMAIN_PROVIDER_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
