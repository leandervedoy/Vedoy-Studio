# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Authentication. Vedøy Login provides identity; Studio keeps its own access list.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=demo@vedoy.no
STUDIO_ALLOWED_EMAILS=demo@vedoy.no
VEDOY_LOGIN_SUPABASE_URL=https://niedmgyyougvgiiuwcvw.supabase.co
VEDOY_LOGIN_CLIENT_ID=
VEDOY_LOGIN_CALLBACK_URL=http://localhost:3000/auth/callback

# Optional PostgreSQL database (Neon, Supabase, Railway, Prisma Postgres, etc.)
DATABASE_URL=

# Optional Vedi AI integration. Never expose this value in client-side code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Stripe Checkout. Use test keys locally, live keys only after the Stripe resource is claimed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BOOKING_PRO_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false

# Optional calendar, messaging and Shopify integrations. Missing values remain explicit demo states.
GOOGLE_CALENDAR_CLIENT_ID=
MICROSOFT_CLIENT_ID=
TWILIO_ACCOUNT_SID=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Vercel Registrar API. Required for live availability, pricing and domain purchase.
VERCEL_REGISTRAR_TOKEN=
VERCEL_REGISTRAR_TEAM_ID=
DOMAIN_USD_NOK_RATE=12

# Hetzner Cloud. When omitted, paid hosting orders are retained for manual provisioning.
HETZNER_API_TOKEN=
HETZNER_SSH_KEY_NAMES=
HETZNER_IMAGE=ubuntu-24.04

# Other optional provider adapters used by Studio modules.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
