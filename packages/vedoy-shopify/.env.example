# Shopify app secret. Keep the real value only in Vercel/environment variables.
SHOPIFY_API_SECRET=replace_with_webhook_signing_secret
SHOPIFY_API_VERSION=2026-07

# Vedøy Growth receiver. It must validate this bearer token and deduplicate webhook IDs.
VEDOY_GROWTH_WEBHOOK_URL=https://growth.vedoy.store/api/integrations/shopify/webhook
VEDOY_GROWTH_WEBHOOK_TOKEN=replace_with_a_long_random_secret
